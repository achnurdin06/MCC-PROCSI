# ==============================================================================
# MIGRATION COMMAND CENTER - ENVIRONMENT TEMPLATE
# ==============================================================================
# Tentukan mode runtime aplikasi:
# NODE_ENV=development (menggunakan .env.development)
# NODE_ENV=production  (menggunakan .env.production)
NODE_ENV=development
APP_ENV=DEV
PORT=3000

# ==============================================================================
# 1. DATABASE APLIKASI (Ditanam Langsung di Aplikasi)
# Menyimpan data login pengguna, role RBAC, metadata konfigurasi migrasi,
# dan seluruh log riwayat run/error (Skema mc_center).
# JANGAN dimaintain di menu Master Connection Settings!
# ==============================================================================
APP_DB_HOST=10.20.94.6
APP_DB_PORT=5433
APP_DB_USER=procsi
APP_DB_PASSWORD=YourPgPasswordHere
APP_DB_NAME=db_procsi
APP_DB_SCHEMA=mc_center
APP_DB_MAX_POOL=10

# Backward-compatibility alias
PG_HOST=10.20.94.6
PG_PORT=5433
PG_USER=procsi
PG_PASSWORD=YourPgPasswordHere
PG_DATABASE=db_procsi
PG_CONNECTION_TIMEOUT_MILLIS=10000

# ==============================================================================
# 2. DEFAULT WORKLOAD SOURCE DATABASE (Sumber Data Bisnis)
# Default fallback jika koneksi belum ditentukan per Client & Environment di UI
# ==============================================================================
MSSQL_SERVER=10.20.95.10
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourPasswordHere
MSSQL_DATABASE=antam_scm
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT=15000

# SSH Tunneling untuk Source Database (jika diakses via VPN/Bastion Host)
MSSQL_USE_SSH_TUNNEL=true
MSSQL_SSH_HOST=10.20.95.10
MSSQL_SSH_PORT=22
MSSQL_SSH_USER=developer
MSSQL_SSH_PASSWORD=YourSshPasswordHere
LOCAL_TUNNEL_PORT=11433
