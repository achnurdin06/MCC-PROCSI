# ==============================================================================
# MIGRATION COMMAND CENTER - ENVIRONMENT TEMPLATE
# ==============================================================================
# Tentukan mode runtime aplikasi:
# NODE_ENV=development (menggunakan .env.development)
# NODE_ENV=production  (menggunakan .env.production)
NODE_ENV=development
APP_ENV=DEV
PORT=3000

# ==============================================================================
# 1. DATABASE APLIKASI (Ditanam Langsung di Aplikasi)
# Menyimpan data login pengguna, role RBAC, metadata konfigurasi migrasi,
# dan seluruh log riwayat run/error (Skema mc_center).
# JANGAN dimaintain di menu Master Connection Settings!
# ==============================================================================
APP_DB_HOST=<HOST_POSTGRESQL>
APP_DB_PORT=5433
APP_DB_USER=<USER_DB_APLIKASI>
APP_DB_PASSWORD=<PASSWORD_DB_APLIKASI>
APP_DB_NAME=<NAMA_DATABASE>
APP_DB_SCHEMA=mc_center
APP_DB_MAX_POOL=10

# Backward-compatibility alias
PG_HOST=<HOST_POSTGRESQL>
PG_PORT=5433
PG_USER=<USER_DB_APLIKASI>
PG_PASSWORD=<PASSWORD_DB_APLIKASI>
PG_DATABASE=<NAMA_DATABASE>
PG_CONNECTION_TIMEOUT_MILLIS=10000

# ==============================================================================
# 3. KEAMANAN APLIKASI & KRIPTOGRAFI (WAJIB MINIMAL 32 KARAKTER)
# Generate string acak 64-karakter dengan: openssl rand -hex 32
# ==============================================================================
# Kunci signing token JWT untuk otentikasi sesi dashboard
JWT_SECRET=<HASIL_OPENSSL_RAND_HEX_32>

# Kunci master enkripsi AES-256-GCM untuk kredensial database pada master_connection
ENCRYPTION_MASTER_KEY=<HASIL_OPENSSL_RAND_HEX_32>

# ==============================================================================
# 4. JARINGAN & REVERSE PROXY (OPSIONAL UNTUK ON-PREMISE PRODUCTION)
# ==============================================================================
# Daftar origin CORS yang diizinkan (dipisahkan koma), kosongkan jika same-origin/localhost
# CORS_ALLOWED_ORIGINS=https://mcc.antam.com,https://dashboard-migrasi.antam.com

# Konfigurasi trust proxy untuk deployment di balik Nginx / Load Balancer
TRUST_PROXY=loopback

# Enkripsi in-transit PostgreSQL (SSL/TLS)
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
